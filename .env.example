# URL pública final, sin barra al final. Se usa para canonical, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com
NEXT_PUBLIC_WEB3FORM=tu_access_key_publica_de_web3forms
# true muestra y exige hCaptcha; false lo oculta y permite enviar sin CAPTCHA.
NEXT_PUBLIC_HCAPTCHA_ENABLED=false
# Opcional: si se omite, se usa la site key compartida de Web3Forms para hCaptcha.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=tu_site_key_publica_de_hcaptcha
